# Copy to .env for local development. Never commit real secrets.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres:///arjoon
# Public origin served by the Next.js server
SITE_URL=http://127.0.0.1:3000
TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Where Django reaches Next.js to revalidate cached pages
NEXT_INTERNAL_URL=http://127.0.0.1:3000
# Shared secret between Django and Next.js: page revalidation and server-side fetches
INTERNAL_SECRET=change-me-too
# Number of proxies in front of Django (Next.js locally; Render LB + Next.js in production)
NUM_PROXIES=1
# Persistent disk mount point (Render: e.g. /var/data)
# DATA_ROOT=/var/data
# Optional separate signing key for JWT
# JWT_SIGNING_KEY=
# Admin alert e-mail. Unset = console backend (printed, not sent).
# EMAIL_URL=smtp+tls://USER:PASSWORD@smtp.example.com:587
# DEFAULT_FROM_EMAIL=بريد عرجون <no-reply@example.com>
